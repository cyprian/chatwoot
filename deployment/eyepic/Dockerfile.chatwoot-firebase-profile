ARG CHATWOOT_VERSION=v4.14.0
FROM chatwoot/chatwoot:${CHATWOOT_VERSION}

USER root
ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN apk add --no-cache patch
COPY deployment/eyepic/chatwoot-firebase-profile.patch /tmp/chatwoot-firebase-profile.patch
COPY deployment/eyepic/apply-hub-egress-gate.rb /tmp/apply-hub-egress-gate.rb
COPY deployment/eyepic/firebase-profile-logo.png /tmp/firebase-profile-logo.png
COPY deployment/eyepic/eye-photo-logo.png /tmp/eye-photo-logo.png
RUN patch --batch --forward -p1 -d /app < /tmp/chatwoot-firebase-profile.patch
RUN ruby /tmp/apply-hub-egress-gate.rb
# Integration settings derive image URLs from the integration id. Provide both
# variants before assets are compiled so they are published with the dashboard.
RUN cp /tmp/firebase-profile-logo.png /app/public/dashboard/images/integrations/firebase_profile.png \
  && cp /tmp/firebase-profile-logo.png /app/public/dashboard/images/integrations/firebase_profile-dark.png
RUN cp /tmp/eye-photo-logo.png /app/public/dashboard/images/integrations/eye_photo.png \
  && cp /tmp/eye-photo-logo.png /app/public/dashboard/images/integrations/eye_photo-dark.png
# Keep the production image aligned with Eyepic's message translation feature.
COPY app/controllers/api/v1/accounts/conversations/messages_controller.rb /app/app/controllers/api/v1/accounts/conversations/messages_controller.rb
COPY app/javascript/dashboard/api/inbox/message.js /app/app/javascript/dashboard/api/inbox/message.js
COPY app/javascript/dashboard/components-next/message/Message.vue /app/app/javascript/dashboard/components-next/message/Message.vue
COPY app/javascript/dashboard/components-next/message/bubbles/Text/Index.vue /app/app/javascript/dashboard/components-next/message/bubbles/Text/Index.vue
COPY app/javascript/dashboard/components-next/message/bubbles/Email/Index.vue /app/app/javascript/dashboard/components-next/message/bubbles/Email/Index.vue
COPY app/javascript/dashboard/store/modules/conversations/actions/messageTranslateActions.js /app/app/javascript/dashboard/store/modules/conversations/actions/messageTranslateActions.js
COPY app/javascript/dashboard/components/widgets/WootWriter/CopilotMenuBar.vue /app/app/javascript/dashboard/components/widgets/WootWriter/CopilotMenuBar.vue
COPY lib/integrations/openai/translation_service.rb /app/lib/integrations/openai/translation_service.rb
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && npm install -g pnpm@10.2.0 \
  && pnpm install --frozen-lockfile --ignore-scripts \
  && SECRET_KEY_BASE=precompile_placeholder RAILS_LOG_TO_STDOUT=enabled bundle exec rake assets:precompile \
  && rm -rf node_modules tmp/cache
